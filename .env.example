NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=
TELEGRAM_BOT_TOKEN=
# Comma-separated for multiple recipients, e.g. 111111111,-1009876543210
TELEGRAM_CHAT_ID=
# Fonnte (WhatsApp gateway) - https://fonnte.com, token from your device dashboard
FONNTE_TOKEN=
# Comma-separated WhatsApp numbers with country code, no +/spaces, e.g. 6281234567890,6289876543210
FONNTE_TARGET=
# Service role key from Supabase Project Settings > API - used only by the cron route, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Random secret string - checked against the "Authorization: Bearer <value>" header on cron requests.
# Also set this same value as a GitHub Actions repo secret named CRON_SECRET.
CRON_SECRET=
# Slack bot token (xoxb-...) with the chat:write scope, invited to the target channel
SLACK_BOT_TOKEN=
# Slack channel ID (not name) to post the daily "Attendance <date>" thread starter to
SLACK_ATTENDANCE_CHANNEL_ID=
# Slack channel ID for the "no purchase request submitted for tomorrow" alert.
# Optional - falls back to SLACK_ATTENDANCE_CHANNEL_ID if not set.
SLACK_MISSING_REQUEST_CHANNEL_ID=
